# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Variables are validated at boot (src/config/env.ts).
# In NODE_ENV=production the app REFUSES TO START if JWT secrets are placeholders,
# JWT_ACCESS_SECRET is unset, APPLE_* are demo values, or ADMIN_FRONTEND_URL is localhost.
# Generate secrets with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# Environment
NODE_ENV=development
PORT=3000

# Refresh-token cookie SameSite policy: lax | strict | none ("none" forces Secure cookies)
SAMESITE_COOKIE=lax

# Run the BullMQ ride-scheduling worker inside the API process.
# Anything except "false" enables it. Set to false when a separate worker container runs.
ENABLE_WORKER=true

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ride_sharing_db?schema=public"
# Optional: direct (non-pooled) connection used only by Prisma migrations (prisma.config.ts).
# Needed behind a pooler such as PgBouncer/Supavisor; falls back to DATABASE_URL when unset.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/ride_sharing_db?schema=public"

# JWT (each secret must be >= 32 chars; REQUIRED and non-placeholder in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
# Legacy access-token lifetime, only relevant while JWT_ACCESS_SECRET falls back to JWT_SECRET
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_here_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_change_in_production
JWT_REFRESH_EXPIRES_IN_DEFAULT=1d
JWT_REFRESH_EXPIRES_IN_REMEMBER=30d

# OTP & Signup Session Configuration
OTP_EXPIRES_IN_SECONDS=300
SIGNUP_SESSION_TTL_SECONDS=900

# SMTP / Nodemailer Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME="Deligo Ride"
EMAIL_FROM_ADDRESS=noreply@deligo.com

# Resend — transactional email. Optional: emails are logged to the console when unset.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Mapbox — routing / ETA. Optional: falls back to OSRM when unset.
# Get a token at https://account.mapbox.com/access-tokens
MAPBOX_ACCESS_TOKEN=

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS — comma-separated browser origins (REST + Socket.IO). Unset in production = no browser origins allowed.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Cloudinary — driver document (KYC) storage
# Get these from https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis — BullMQ job queues & geospatial driver tracking
REDIS_URL=redis://localhost:6379

# Firebase Admin — push notifications (FCM)
# Set path to your downloaded service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# BulkGate — transactional SMS gateway
# Sign up at https://portal.bulkgate.com
# Then: Administration → Applications → Create Application → copy ID & Token
BULKGATE_APPLICATION_ID=your_application_id
BULKGATE_APPLICATION_TOKEN=your_application_token

# Google OAuth — client IDs are the accepted ID-token audiences
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_android_client_id_optional
GOOGLE_IOS_CLIENT_ID=your_ios_client_id_optional

# Facebook Login
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
META_APP_ID=your_facebook_app_id_here
META_APP_SECRET=your_facebook_app_secret_here

# Apple Sign-In — in production set your REAL identifiers; the .demo defaults are rejected.
# APPLE_DEMO_MODE is ignored (forced off) when NODE_ENV=production.
APPLE_CLIENT_ID=com.deligo.web.demo
APPLE_BUNDLE_ID=com.deligo.app.demo
APPLE_DEMO_MODE=true

# Admin Frontend — base URL used in admin invite links. Must NOT be localhost in production.
ADMIN_FRONTEND_URL=http://localhost:3000/admin
