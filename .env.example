# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Variables are validated at boot (src/config/env.ts).
# In NODE_ENV=production the app REFUSES TO START if JWT secrets are placeholders,
# JWT_ACCESS_SECRET is unset, APPLE_* are demo values, or ADMIN_FRONTEND_URL is localhost.
# Generate secrets with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# Environment
NODE_ENV=development
PORT=3000

# Refresh-token cookie SameSite policy: lax | strict | none ("none" forces Secure cookies)
SAMESITE_COOKIE=lax

# Run the BullMQ ride-scheduling worker inside the API process.
# Anything except "false" enables it. Set to false when a separate worker container runs.
ENABLE_WORKER=true

# Database (Docker Compose Postgres service or local Postgres)
DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/deligo_db?schema=public"
# Optional: direct (non-pooled) connection used only by Prisma migrations (prisma.config.ts).
# Needed behind a pooler such as PgBouncer/Supavisor; falls back to DATABASE_URL when unset.
DIRECT_URL="postgresql://postgres:postgrespassword@postgres:5432/deligo_db?schema=public"

# JWT (each secret must be >= 32 chars; REQUIRED and non-placeholder in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
# Legacy access-token lifetime, only relevant while JWT_ACCESS_SECRET falls back to JWT_SECRET
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_here_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_change_in_production
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN_DEFAULT=1d
JWT_REFRESH_EXPIRES_IN_REMEMBER=30d

# OTP & Signup Session Configuration
OTP_EXPIRES_IN_SECONDS=300
SIGNUP_SESSION_TTL_SECONDS=900

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# First-run Super Admin bootstrap (leave unset to skip creating the account)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=
SUPER_ADMIN_PHONE=

# CORS & Frontend
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Base URL used in admin invite links. Must NOT be localhost in production.
ADMIN_FRONTEND_URL=http://localhost:3000/admin

# RustFS — S3-compatible object storage (KYC documents, vehicle photos)
# RUSTFS_ENDPOINT: API URL, e.g. http://rustfs:9000 (inside compose) or http://localhost:9000
# RUSTFS_PUBLIC_URL: optional public base URL used to build returned file URLs.
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=deligo-ride-sharing
RUSTFS_PUBLIC_URL=http://localhost:9000/deligo-ride-sharing
UPLOAD_ALLOWED_URL_HOSTS=

# Redis — BullMQ job queues & geospatial driver tracking
REDIS_URL=redis://redis:6379

# Firebase Admin — push notifications (FCM)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# BulkGate — transactional SMS gateway
BULKGATE_APPLICATION_ID=
BULKGATE_APPLICATION_TOKEN=

# SMTP / Nodemailer Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME="Deligo Ride"
EMAIL_FROM_ADDRESS=noreply@deligo.com

# Resend — transactional email (optional; logs to console when unset)
RESEND_API_KEY=

# Mapbox — routing / ETA (optional; falls back to OSRM when unset)
MAPBOX_ACCESS_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Facebook / Meta Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_APP_ID=
META_APP_SECRET=

# Apple Sign-In (in production set REAL identifiers; .demo defaults are rejected)
APPLE_CLIENT_ID=com.deligo.web.demo
APPLE_BUNDLE_ID=com.deligo.app.demo
APPLE_DEMO_MODE=true

# Docmost
DOCMOST_APP_URL=http://localhost:3001
DOCMOST_APP_SECRET=change_this_docmost_secret_min_32_chars
DOCMOST_DB_USER=docmost
DOCMOST_DB_PASSWORD=change_this_docmost_db_password
DOCMOST_DB_NAME=docmost_db