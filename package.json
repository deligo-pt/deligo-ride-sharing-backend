{
  "name": "ride-sharing-backend",
  "version": "1.0.0",
  "description": "Production-ready REST API backend for a Ride-Sharing platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:dev": "ts-node prisma/seed.dev.ts",
    "type-check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test:admin": "ts-node scripts/test-admin-auth.ts",
    "test:driver": "ts-node scripts/test-driver-auth.ts",
    "test:google": "ts-node scripts/test-google-auth.ts",
    "test:social": "ts-node scripts/test-social-auth.ts",
    "test:rustfs": "ts-node scripts/test-rustfs.ts",
    "test:e2e": "ts-node scripts/test-auth-e2e.ts",
    "test:all": "npm run test:rustfs && npm run test:admin && npm run test:driver && npm run test:google && npm run test:social && npm run test:e2e",
    "test": "npm run test:all"
  },
  "keywords": [
    "ride-sharing",
    "express",
    "typescript",
    "prisma",
    "rest-api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@aws-sdk/s3-request-presigner": "^3.1061.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/cookie-parser": "^1.4.10",
    "axios": "^1.17.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.78.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "ejs": "^7.0.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jose": "^4.15.9",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.17",
    "multer": "^2.1.1",
    "nodemailer": "^10.6.0",
    "pg": "^8.21.0",
    "resend": "^6.12.4",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.9",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
