enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN
}

enum WalletTxType {
  REFERRAL_BONUS
  RIDE_PAYMENT
  PROMO_CREDIT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DEACTIVATED
}

enum AccessLabel {
  SUPER_ADMIN
  SUPPORT
  REGIONAL
}

// USER — Core identity only. Authentication is handled by an external microservice.

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  phone     String     @unique
  firstName String?
  lastName  String?
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)

  // Push notification token (set by the mobile app via PATCH /api/v1/users/fcm-token)
  fcmToken String?

  // ── Referral System ──────────────────────────────────────────────────────
  /// Unique invite code — auto-generated on registration (e.g. "JOHN-A3X9").
  /// The @default(cuid()) satisfies existing rows during migration; the real
  /// code is always generated in the application layer via generateReferralCode().
  referralCode String  @unique @default(cuid())
  /// ID of the User who referred this user. Null if they signed up organically.
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Relations
  customerProfile       CustomerProfile?
  driverProfile         DriverProfile?
  adminProfile          AdminProfile?
  notificationsReceived Notification[]
  reviewsGiven          Review[]            @relation("ReviewAuthor")
  reviewsReceived       Review[]            @relation("ReviewTarget")
  wallet                Wallet?
  walletTransactions    WalletTransaction[]
  promoUsages           PromoUsage[]
  emergencyContacts     EmergencyContact[]
  supportTickets        SupportTicket[]     @relation("TicketCreator")
  assignedTickets       SupportTicket[]     @relation("TicketAdmin")
  sosAlertsInitiated    EmergencyAlert[]    @relation("SosInitiator")
  sosAlertsResolved     EmergencyAlert[]    @relation("SosResolver")

  @@index([email])
  @@index([phone])
  @@index([referralCode])
  @@map("users")
}

// CUSTOMER PROFILE

model CustomerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalRides    Int     @default(0)
  totalReviews  Int     @default(0)
  averageRating Float   @default(5.0)
  homeAddress   String?
  workAddress   String?

  emergencyContactNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rides Ride[] @relation("CustomerRides")

  @@map("customer_profiles")
}

//  ADMIN PROFILE
model AdminProfile {
  id             String      @id @default(uuid())
  userId         String      @unique
  accessLabel    AccessLabel @default(SUPER_ADMIN)
  assignedRegion String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

// PAYMENTS & WALLET => demo 

model Wallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance  Float  @default(0)
  currency String @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id     String @id @default(uuid())
  /// The user who earned / was charged this transaction.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Also linked to the Wallet for balance aggregation.
  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  amount      Float
  type        WalletTxType
  description String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([walletId])
  @@map("wallet_transactions")
}
