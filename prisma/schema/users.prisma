enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN
  FLEET_MANAGER
}

enum FleetVerificationStatus {
  PENDING_VERIFICATION
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum FleetSignerType {
  MYSELF
  AUTHORIZED_REPRESENTATIVE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DEACTIVATED
}

enum AccessLabel {
  SUPER_ADMIN
  SUPPORT
  REGIONAL
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
  APPLE
  FACEBOOK
}

enum PreferredLanguage {
  EN
  PT
}

model Account {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          AuthProvider
  providerAccountId String
  email             String?
  phone             String?
  passwordHash      String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model User {
  id                String             @id @default(uuid())
  email             String?            @unique
  phone             String?            @unique
  firstName         String?
  lastName          String?
  role              UserRole           @default(CUSTOMER)
  status            UserStatus         @default(ACTIVE)
  previousStatus    UserStatus?
  profilePicture    String?
  preferredLanguage PreferredLanguage? @default(EN)

  referralCode String  @unique
  referrerId   String?
  referrer     User?   @relation("UserReferrals", fields: [referrerId], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("UserReferrals")

  fcmToken  String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account               Account[]
  sessions              Session[]
  customerProfile       CustomerProfile?
  driverProfile         DriverProfile?
  adminProfile          AdminProfile?
  fleetManagerProfile   FleetManagerProfile?
  notificationsReceived Notification[]
  reviewsGiven          Review[]             @relation("ReviewAuthor")
  reviewsReceived       Review[]             @relation("ReviewTarget")
  wallet                Wallet?
  promoUsages           PromoUsage[]
  emergencyContacts     EmergencyContact[]
  supportTickets        SupportTicket[]      @relation("TicketCreator")
  assignedTickets       SupportTicket[]      @relation("TicketAdmin")
  sosAlertsInitiated    EmergencyAlert[]     @relation("SosInitiator")
  sosAlertsResolved     EmergencyAlert[]     @relation("SosResolver")

  @@index([referrerId])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  rememberMe Boolean  @default(false)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model CustomerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalRides    Int     @default(0)
  totalReviews  Int     @default(0)
  averageRating Float   @default(5.0)
  homeAddress   String?
  workAddress   String?

  emergencyContactNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rides Ride[] @relation("CustomerRides")

  @@map("customer_profiles")
}

model AdminProfile {
  id             String      @id @default(uuid())
  userId         String      @unique
  accessLabel    AccessLabel @default(SUPPORT)
  assignedRegion String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model FleetManagerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName      String?
  legalBusinessName String?
  licenseNumber     String? @unique
  nifNumber         String? @unique
  businessEmail     String?
  businessPhone     String?

  latitude   Float?
  longitude  Float?
  street     String?
  city       String?
  district   String?
  state      String?
  postalCode String?
  country    String?

  accountHolderName String?
  iban              String?

  photoUrl                  String?
  businessLicenseUrl        String?
  businessLicenseExpiresAt  DateTime?
  idProofFrontUrl           String?
  idProofBackUrl            String?
  idProofExpiresAt          DateTime?
  addressProofUrl           String?
  addressProofExpiresAt     DateTime?
  activityDocumentUrl       String?
  activityDocumentExpiresAt DateTime?
  ibanProofUrl              String?
  ibanProofExpiresAt        DateTime?

  signerType         FleetSignerType?
  representativeName String?
  representativeId   String?
  signatureUrl       String?
  termsAcceptedAt    DateTime?
  privacyAcceptedAt  DateTime?

  verificationStatus         FleetVerificationStatus  @default(PENDING_VERIFICATION)
  previousVerificationStatus FleetVerificationStatus?
  submittedAt                DateTime?
  reviewedAt                 DateTime?
  reviewedById               String?
  rejectionReason            String?
  adminNote                  String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([verificationStatus])
  @@map("fleet_manager_profiles")
}

model Wallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance  Decimal @default(0) @db.Decimal(12, 2)
  currency String  @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amount      Decimal @db.Decimal(12, 2)
  type        String
  description String?
  reference   String?

  createdAt DateTime @default(now())

  @@index([walletId])
  @@map("wallet_transactions")
}
