enum TicketType {
  SAFETY
  COMPLAINT
  LOST_ITEM
  GENERAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model EmergencyContact {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  phoneNumber String
  relation    String

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("emergency_contacts")
}

model SupportTicket {
  id String @id @default(uuid())

  userId String
  user   User   @relation("TicketCreator", fields: [userId], references: [id], onDelete: Cascade)

  rideId String?
  ride   Ride?   @relation(fields: [rideId], references: [id])

  subject     String
  description String
  type        TicketType
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  adminId String?
  admin   User?   @relation("TicketAdmin", fields: [adminId], references: [id])

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]

  @@index([userId, status])
  @@index([status, priority])
  @@map("support_tickets")
}

model TicketMessage {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId String
  message  String

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

enum AlertInitiatorRole {
  CUSTOMER
  DRIVER
}

enum EmergencyAlertStatus {
  ACTIVE
  RESOLVED
  FALSE_ALARM
}

model EmergencyAlert {
  id String @id @default(uuid())

  rideId String?

  initiatorId String
  initiator   User   @relation("SosInitiator", fields: [initiatorId], references: [id])

  initiatorRole AlertInitiatorRole

  lat Float
  lng Float

  status EmergencyAlertStatus @default(ACTIVE)

  resolvedById String?
  resolvedBy   User?   @relation("SosResolver", fields: [resolvedById], references: [id])

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([initiatorId])
  @@map("emergency_alerts")
}
