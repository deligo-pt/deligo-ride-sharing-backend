enum DiscountType {
  FLAT
  PERCENTAGE
}

// PROMO CODES

model PromoCode {
  id             String       @id @default(uuid())
  /// Stored as uppercase. Enforced at the application layer via Zod transform.
  code           String       @unique
  discountType   DiscountType
  discountValue  Float
  /// For PERCENTAGE codes: cap the maximum discount amount. Null = uncapped.
  maxDiscountCap Float?
  /// Minimum ride fare required to apply this promo code.
  minRideValue   Float        @default(0)
  maxGlobalUses  Int
  currentUses    Int          @default(0)
  validFrom      DateTime
  validUntil     DateTime
  isActive       Boolean      @default(true)

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())

  // Relations
  rides  Ride[]
  usages PromoUsage[]

  @@map("promo_codes")
}

/// Records a single redemption of a PromoCode by a User.
/// Written when a ride reaches COMPLETED status with a promo attached.
model PromoUsage {
  id String @id @default(uuid())

  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Optional: populated once the ride that used the code is COMPLETED.
  rideId String?

  /// The actual monetary discount that was applied to the ride fare.
  discountApplied Float

  createdAt DateTime @default(now())

  @@index([promoCodeId])
  @@index([userId])
  @@map("promo_usages")
}

// ── Referral Campaign Config (Singleton) ─────────────────────────────────────

/// Global configuration for the referral programme.
/// Treated as a singleton — only one row should exist (id = "default").
/// Admin can update bonus amounts and toggle the campaign via
///   PATCH /api/v1/admin/referrals/config
model ReferralCampaign {
  /// Always "default" — enforces the singleton pattern.
  id String @id @default("default")

  /// Amount credited to the referrer (the person who shared the code).
  referrerBonusAmount Float @default(10.0)

  /// Amount credited to the referee (the new user who used the code).
  refereeBonusAmount Float @default(5.0)

  /// When false, no bonuses are paid even if a referral is detected.
  isActive Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("referral_campaigns")
}
