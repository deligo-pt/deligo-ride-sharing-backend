generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PricingRule {
  id                 String      @id @default(uuid())
  vehicleType        VehicleType @unique
  baseFare           Float
  perKmRate          Float
  perMinRate         Float
  surgeMultiplier    Float       @default(1.0)
  adminFeePercentage Float       @default(20.0)
  updatedAt          DateTime    @updatedAt

  @@map("pricing_rules")
}

// ── Geofencing ───────────────────────────────────────────────────────────────

enum ZoneType {
  RESTRICTED
  SURCHARGE
}

model Zone {
  id              String   @id @default(uuid())
  name            String // e.g. "JFK Airport", "Downtown Core"
  polygon         Json // Array of [lat, lng] coordinate pairs
  type            ZoneType
  surchargeAmount Float    @default(0) // Flat fee added to the fare (SURCHARGE zones only)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("zones")
}
