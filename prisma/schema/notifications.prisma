enum NotificationType {
  RIDE_REQUEST
  RIDE_ACCEPTED
  RIDE_COMPLETED
  RIDE_CANCELLED
  RIDE_UPDATE
  PAYMENT
  PROMO
  SYSTEM
  SECURITY
}

// NOTIFICATIONS

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   NotificationType
  title  String
  body   String
  data   Json?
  isRead Boolean          @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@map("notifications")
}
