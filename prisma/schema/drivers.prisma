enum KycStatus {
  NOT_SUBMITTED
  PENDING_DOCS
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  TEMPORARILY_BLOCKED
}

model DriverProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  licenseNumber     String?    @unique
  licenseExpiresAt  DateTime?
  totalRides        Int        @default(0)
  totalReviews      Int        @default(0)
  averageRating     Float      @default(5.0)
  kycStatus         KycStatus  @default(NOT_SUBMITTED)
  previousKycStatus KycStatus?
  isAvailable       Boolean    @default(false)
  currentLatitude   Float?
  currentLongitude  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  vehicle  Vehicle?
  document DriverDocument?
  rides    Ride[]          @relation("DriverRides")

  @@map("driver_profiles")
}

model Vehicle {
  id              String        @id @default(uuid())
  driverProfileId String        @unique
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  vehicleClass VehicleClass
  vehicleType  VehicleType
  brand        String
  model        String
  year         Int
  color        String
  licensePlate String       @unique
  capacity     Int          @default(4)

  registrationExpiryDate DateTime?
  insuranceExpiryDate    DateTime?

  photoUrls String[] @default([])

  approvalStatus VehicleApprovalStatus @default(PENDING_REVIEW)
  adminNote      String?
  reviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicles")
}

model DriverDocument {
  id              String        @id @default(uuid())
  driverProfileId String        @unique
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  drivingLicenseUrl            String?
  drivingLicenseExpiresAt      DateTime?
  nationalIdUrl                String?
  nationalIdExpiresAt          DateTime?
  vehicleRegistrationUrl       String?
  vehicleRegistrationExpiresAt DateTime?
  vehicleInsuranceUrl          String?
  vehicleInsuranceExpiresAt    DateTime?
  driverSelfieUrl              String?
  proofOfAddressUrl            String?
  proofOfAddressExpiresAt      DateTime?
  taxIdUrl                     String?
  taxIdExpiresAt               DateTime?

  verificationStatus         DocumentStatus  @default(PENDING)
  previousVerificationStatus DocumentStatus?
  reviewNote                 String?
  reviewedAt                 DateTime?
  rejectionReason            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("driver_documents")
}
