enum RideStatus {
  SCHEDULED
  REQUESTED
  ACCEPTED
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EMERGENCY
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum RideStopStatus {
  PENDING
  ARRIVED
  COMPLETED
}

// RIDES

model Ride {
  id              String          @id @default(uuid())
  customerId      String
  customerProfile CustomerProfile @relation("CustomerRides", fields: [customerId], references: [id])
  driverProfileId String?
  driverProfile   DriverProfile?  @relation("DriverRides", fields: [driverProfileId], references: [id])
  vehicleClass    VehicleClass    @default(ECONOMY)
  vehicleType     VehicleType     @default(Hatchback)
  status          RideStatus      @default(REQUESTED)

  // Pickup
  pickupAddress   String
  pickupLatitude  Float
  pickupLongitude Float

  // Dropoff
  dropoffAddress   String
  dropoffLatitude  Float
  dropoffLongitude Float

  // Fare
  estimatedFare     Decimal  @db.Decimal(10, 2)
  finalFare         Decimal? @db.Decimal(10, 2)
  // Estimated at ride-request time (from routing engine)
  estimatedDistance Float? // kilometres
  estimatedDuration Int? // minutes
  // Actual values recorded at trip completion
  distanceKm        Float?
  durationMinutes   Int?

  // Timestamps
  scheduledAt        DateTime? // set when status = SCHEDULED
  requestedAt        DateTime  @default(now())
  acceptedAt         DateTime?
  arrivedAt          DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  promoCodeId String?
  promoCode   PromoCode?      @relation(fields: [promoCodeId], references: [id])
  payment     Payment?
  reviews     Review[] // one per direction: customer→driver AND driver→customer
  tickets     SupportTicket[]
  stops       RideStop[] // intermediate waypoints for multi-stop rides

  @@index([customerId, status])
  @@index([driverProfileId, status])
  @@map("rides")
}

model Payment {
  id     String @id @default(uuid())
  rideId String @unique
  ride   Ride   @relation(fields: [rideId], references: [id])

  amount         Float
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  transactionRef String?       @unique
  paidAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

// ── Multi-Stop Routing  —  PRD 3.4 ────────────────────────────────────────────

/// An intermediate waypoint within a multi-stop ride.
/// sequence starts at 1; pickup is 0, dropoff is implied last.
model RideStop {
  id     String @id @default(uuid())
  rideId String
  ride   Ride   @relation(fields: [rideId], references: [id], onDelete: Cascade)

  address String
  lat     Float
  lng     Float

  /// 1-based ordering of stops between pickup and final dropoff.
  sequence Int

  status RideStopStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rideId, sequence])
  @@map("ride_stops")
}

// ── Recurring Rides  —  PRD 3.9 ───────────────────────────────────────────────

/// A customer's repeating ride template.
/// The factory engine (recurring.service.ts) reads all active profiles every
/// day and mints SCHEDULED Ride records for the next execution window.
model RecurringRideProfile {
  id     String @id @default(uuid())
  userId String /// References User.id (not customerProfile, for simplicity)

  vehicleType VehicleType

  pickupAddress String
  pickupLat     Float
  pickupLng     Float

  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float

  /// ISO weekday numbers: 1 = Monday … 7 = Sunday.
  /// Stored as Int[] (PostgreSQL integer array).
  daysOfWeek Int[]

  /// Local time of day in 'HH:MM' format, e.g. "08:30".
  timeOfDay String

  startDate DateTime
  endDate   DateTime

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@map("recurring_ride_profiles")
}
