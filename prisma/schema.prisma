

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum UserRole {
  CUSTOMER 
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DEACTIVATED
}
enum AccessLabel {
  SUPER_ADMIN
  SUPPORT
  REGIONAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum VehicleType {
 SUV
 Sedan
 Hatchback
Micro
Motorcycle
PickupTruck
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  TEMPORARILY_BLOCKED
}

enum NotificationType {
  RIDE_REQUEST
  RIDE_ACCEPTED
  RIDE_COMPLETED
  RIDE_CANCELLED
  RIDE_UPDATE
  PAYMENT
  PROMO
  SYSTEM
  SECURITY
}

// USER — Core identity only. Authentication is handled by an external microservice.

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  phone       String     @unique
  firstName   String?
  lastName    String?
  role        UserRole   @default(CUSTOMER)
  status      UserStatus @default(ACTIVE)

  // Push notification token (set by the mobile app via PATCH /api/v1/users/fcm-token)
  fcmToken    String?

  // Relations
  customerProfile       CustomerProfile?
  driverProfile         DriverProfile?
  adminProfile          AdminProfile?
  notificationsReceived Notification[]
  reviewsGiven          Review[]   @relation("ReviewAuthor")
  reviewsReceived       Review[]   @relation("ReviewTarget")
  wallet                Wallet?

  @@index([email])
  @@index([phone])
  @@map("users")
}

// CUSTOMER PROFILE


model CustomerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalRides      Int      @default(0)
  totalReviews    Int      @default(0)
  averageRating   Float    @default(5.0)
  homeAddress     String?
  workAddress     String?

  emergencyContactNumber String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  rides           Ride[]   @relation("CustomerRides")

  @@map("customer_profiles")
}



//  ADMIN PROFILE
model AdminProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  accessLabel     AccessLabel @default(SUPER_ADMIN)
  assignedRegion  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("admin_profiles")
}
  
// DRIVER PROFILE


model DriverProfile {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  licenseNumber     String         @unique
  licenseExpiresAt  DateTime
  totalRides        Int            @default(0)
  totalReviews      Int            @default(0)
  averageRating     Float          @default(5.0)
  isAvailable       Boolean        @default(false)
  currentLatitude   Float?
  currentLongitude  Float?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  vehicle           Vehicle?
  document          DriverDocument?
  rides             Ride[]         @relation("DriverRides")

  @@map("driver_profiles")
}

enum VehicleClass{
  ECONOMY
  COMFORT
  PREMIUM

}
enum VehicleApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model Vehicle {
  id                String               @id @default(uuid())
  driverProfileId   String               @unique
  driverProfile     DriverProfile        @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  vehicleClass      VehicleClass
  vehicleType       VehicleType
  brand             String
  model             String
  year              Int
  color             String
  licensePlate      String               @unique
  capacity          Int                  @default(4)

  registrationExpiryDate  DateTime?
  insuranceExpiryDate     DateTime?

  photoUrls         String[]             @default([])

  approvalStatus    VehicleApprovalStatus @default(PENDING_REVIEW)
  adminNote         String?
  reviewedAt        DateTime?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@map("vehicles")
}

model DriverDocument {
  id              String         @id @default(uuid())
  driverProfileId String         @unique
  driverProfile   DriverProfile  @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  
  drivingLicenseUrl       String
  nationalIdUrl           String
  vehicleRegistrationUrl  String
  vehicleInsuranceUrl     String
  driverSelfieUrl         String
  proofOfAddressUrl       String
  taxIdUrl                String

  drivingLicenseExpiry      DateTime?
  vehicleRegistrationExpiry DateTime?
  vehicleInsuranceExpiry    DateTime?

  verificationStatus    DocumentStatus @default(PENDING)
  reviewNote      String?
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("driver_documents")
}

// RIDES

model Ride {
  id                  String       @id @default(uuid())
  customerId      String
  customerProfile     CustomerProfile @relation("CustomerRides", fields: [customerId], references: [id])
  driverProfileId     String?
  driverProfile       DriverProfile? @relation("DriverRides", fields: [driverProfileId], references: [id])
  vehicleClass      VehicleClass @default(ECONOMY)
  vehicleType         VehicleType  @default(Hatchback)
  status              RideStatus   @default(REQUESTED)

  // Pickup
  pickupAddress       String
  pickupLatitude      Float
  pickupLongitude     Float

  // Dropoff
  dropoffAddress      String
  dropoffLatitude     Float
  dropoffLongitude    Float

  // Fare
  estimatedFare       Decimal  @db.Decimal(10, 2)
  finalFare           Decimal?  @db.Decimal(10, 2)
  distanceKm          Float?
  durationMinutes     Int?


  // Timestamps
  requestedAt         DateTime     @default(now())
  acceptedAt          DateTime?
  arrivedAt           DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Relations
  promoCodeId       String?
promoCode         PromoCode? @relation(fields: [promoCodeId], references: [id])
  payment             Payment?
  reviews             Review[]   // one per direction: customer→driver AND driver→customer

  @@index([customerId, status])
  @@index([driverProfileId, status])
  @@map("rides")
}

// PAYMENTS & WALLET => demo 

model Payment {
  id              String        @id @default(uuid())
  rideId          String        @unique
  ride            Ride          @relation(fields: [rideId], references: [id])

  amount          Float
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionRef  String?       @unique
  paidAt          DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}

model Wallet {
  id              String          @id @default(uuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance         Float           @default(0)
  currency        String          @default("USD")

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  transactions    WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amount      Float
  type        String   // "CREDIT" | "DEBIT"
  description String?
  reference   String?

  createdAt   DateTime @default(now())

  @@index([walletId])
  @@map("wallet_transactions")
}

// REVIEWS
// One review per direction per ride (author+ride is unique).
// A customer can review the driver AND the driver can review the customer.

model Review {
  id          String   @id @default(uuid())
  rideId      String
  ride        Ride     @relation(fields: [rideId], references: [id])

  authorId    String
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId    String
  target      User     @relation("ReviewTarget", fields: [targetId], references: [id])

  rating      Int      // 1-5, enforced by Zod at the application layer
  comment     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Guarantees each user can only review once per ride
  @@unique([rideId, authorId])
  @@index([targetId])
  @@map("reviews")
}

// NOTIFICATIONS

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  body        String
  data        Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, isRead])
  @@map("notifications")
}

// PROMO CODES

enum DiscountType{
  PERCENTAGE
  FIXED
}

model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique
  discountType      DiscountType @default(PERCENTAGE)
  minimumFareAmount Decimal? @db.Decimal(10, 2)
  description     String?
  discountPercent Float?
  discountAmount  Decimal? @db.Decimal(10, 2)
  maxUses         Int?
  usedCount       Int       @default(0)
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // relations 
  rides             Ride[]

  @@map("promo_codes")
}
