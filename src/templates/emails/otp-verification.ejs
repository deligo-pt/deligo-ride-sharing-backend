<%
  const isPt = preferredLanguage === 'PT';
  const heading = isPt ? 'Verificação de Conta' : 'Verify Your Account';
  const greeting = name ? (isPt ? `Olá, ${name}!` : `Hello, ${name}!`) : (isPt ? 'Olá!' : 'Hello!');
  const intro = isPt 
    ? 'Obrigado por se cadastrar no Deligo. Use o código de verificação abaixo para confirmar sua conta:'
    : 'Thank you for registering with Deligo. Please use the verification code below to confirm your account:';
  const expiryText = isPt
    ? `Este código é válido por ${expiryMinutes || 5} minutos.`
    : `This code is valid for ${expiryMinutes || 5} minutes.`;
  const warningTitle = isPt ? 'Aviso de Segurança:' : 'Security Notice:';
  const warningText = isPt
    ? 'Nunca compartilhe este código com ninguém. A equipe Deligo nunca solicitará seu código por telefone, e-mail ou mensagem.'
    : 'Never share this code with anyone. Deligo staff will never ask you for your code via phone, email, or message.';
  const ignoreText = isPt
    ? 'Se você não solicitou este código, ignore esta mensagem com segurança.'
    : 'If you did not request this verification code, you can safely ignore this email.';
%>

<div style="text-align: left;">
  <h2 style="font-size: 20px; font-weight: 700; color: #0f172a; margin-top: 0; margin-bottom: 16px;"><%= heading %></h2>
  <p style="font-size: 15px; color: #334155; line-height: 1.6; margin-bottom: 20px;"><%= greeting %></p>
  <p style="font-size: 15px; color: #334155; line-height: 1.6; margin-bottom: 24px;"><%= intro %></p>

  <div style="text-align: center; margin: 32px 0;">
    <div style="display: inline-block; background-color: #f1f5f9; border: 2px dashed #cbd5e1; border-radius: 8px; padding: 16px 36px;">
      <span style="font-family: 'Courier New', Courier, monospace; font-size: 34px; font-weight: 800; letter-spacing: 8px; color: #0f172a;"><%= otpCode %></span>
    </div>
    <p style="font-size: 13px; color: #64748b; margin-top: 12px; margin-bottom: 0;"><%= expiryText %></p>
  </div>

  <div style="background-color: #fffbeb; border-left: 4px solid #f59e0b; padding: 14px 16px; border-radius: 4px; margin: 28px 0;">
    <strong style="color: #b45309; font-size: 13px; display: block; margin-bottom: 4px;"><%= warningTitle %></strong>
    <p style="color: #92400e; font-size: 13px; line-height: 1.5; margin: 0;"><%= warningText %></p>
  </div>

  <p style="font-size: 13px; color: #94a3b8; line-height: 1.5; margin-top: 24px; margin-bottom: 0;"><%= ignoreText %></p>
</div>
