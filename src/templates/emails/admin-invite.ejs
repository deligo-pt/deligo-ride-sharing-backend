<%
  const isPt = typeof preferredLanguage !== 'undefined' && preferredLanguage === 'PT';
  const heading = isPt ? 'Convite de Administrador Deligo' : 'Deligo Administrator Invitation';
  const greeting = name ? (isPt ? `Olá, ${name}!` : `Hello, ${name}!`) : (isPt ? 'Olá!' : 'Hello!');
  const intro = isPt 
    ? `Você foi convidado como administrador (${role || 'ADMIN'}) na plataforma Deligo Ride-Sharing. Para ativar sua conta e acessar o painel administrativo, defina sua senha segura clicando no botão abaixo.`
    : `You have been invited as an administrator (${role || 'ADMIN'}) on the Deligo Ride-Sharing platform. To activate your account and access the admin dashboard, please set your secure password by clicking the button below.`;
  const expiryNote = isPt
    ? `Este link de convite é válido por ${expiresInHours || 24} horas e só pode ser utilizado uma vez.`
    : `This invitation link is valid for ${expiresInHours || 24} hours and can only be used once.`;
  const ctaText = isPt ? 'Definir Senha de Acesso' : 'Set Your Admin Password';
  const securityWarning = isPt
    ? 'Se você não esperava este convite, ignore este e-mail com segurança.'
    : 'If you were not expecting this invitation, please safely ignore this email.';
%>

<div style="text-align: left;">
  <h2 style="font-size: 22px; font-weight: 700; color: #0f172a; margin-top: 0; margin-bottom: 16px;"><%= heading %></h2>
  <p style="font-size: 15px; color: #334155; line-height: 1.6; margin-bottom: 16px;"><%= greeting %></p>
  <p style="font-size: 15px; color: #334155; line-height: 1.6; margin-bottom: 24px;"><%= intro %></p>

  <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 24px; text-align: center; margin: 28px 0;">
    <a href="<%= inviteUrl %>" style="display: inline-block; background-color: #0f172a; color: #ffffff; text-decoration: none; font-weight: 600; font-size: 15px; padding: 14px 32px; border-radius: 6px; box-shadow: 0 2px 4px rgba(15, 23, 42, 0.2);"><%= ctaText %></a>
    <p style="font-size: 12px; color: #64748b; margin-top: 16px; margin-bottom: 0; line-height: 1.5;"><%= expiryNote %></p>
  </div>

  <p style="font-size: 13px; color: #64748b; line-height: 1.6; margin-bottom: 12px;">
    <strong>Or copy and paste this link into your browser:</strong><br />
    <a href="<%= inviteUrl %>" style="color: #0284c7; word-break: break-all; font-family: monospace; font-size: 12px;"><%= inviteUrl %></a>
  </p>

  <div style="border-top: 1px solid #f1f5f9; padding-top: 16px; margin-top: 24px;">
    <p style="font-size: 12px; color: #94a3b8; line-height: 1.5; margin: 0;"><%= securityWarning %></p>
  </div>
</div>
